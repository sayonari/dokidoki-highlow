{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "noUnusedLocals": true,
    "resolveJsonModule": true, "skipLibCheck": true, "isolatedModules": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "scripts"]
}
